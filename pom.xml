                <groupId>top.continew.admin</groupId>
                <artifactId>continew-system</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 公共模块（存放公共工具类，公共配置等） -->
            <dependency>
                <groupId>top.continew.admin</groupId>
                <artifactId>continew-common</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 能力开放插件（后续会改造为独立插件） -->
            <dependency>
                <groupId>top.continew.admin</groupId>
                <artifactId>continew-plugin-open</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 租户插件（后续会改造为独立插件） -->
