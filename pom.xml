                <groupId>top.continew.admin</groupId>
                <artifactId>continew-plugin-schedule</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 代码生成器插件（后续会改造为独立插件） -->
            <dependency>
                <groupId>top.continew.admin</groupId>
                <artifactId>continew-plugin-generator</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 显式声明使用本地的 API 文档 Starter -->
            <dependency>
                <groupId>top.continew.starter</groupId>
                <artifactId>continew-starter-api-doc</artifactId>
                <version>${continew-starter.version}</version>
            </dependency>

            <!-- 显式声明使用本地的 Auth 相关 Starter -->
